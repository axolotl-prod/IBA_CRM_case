# The production CSV URL is built into the server. Set this only to override it
# for a staging or test sheet.
# GOOGLE_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/e/EXAMPLE/pub?gid=0&single=true&output=csv

# Telegram notifications for new Google Sheets leads.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: CRM determines the username through getMe when omitted.
TELEGRAM_BOT_USERNAME=
# Set false only when another process or webhook receives bot updates.
TELEGRAM_POLLING_ENABLED=true

# Optional path to the Edge executable used for local PDF generation.
# EDGE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
